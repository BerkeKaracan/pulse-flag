# Local Docker Compose Postgres (host port 5433)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/pulse_flag

# Production (Supabase on Render/Fly/etc.): use Session pooler (IPv4), not db.*.supabase.co
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_REF:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Required. Protects /admin/* as a service key (Next.js BFF). Must match FEATURE_FLAGS_ADMIN_API_KEY.
# Generate: openssl rand -hex 32
FEATURE_FLAGS_API_KEY=change-me-to-a-long-random-secret

# Required for admin identity. Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# development | production  (production hides /docs and tightens CORS)
APP_ENV=development

# Exact admin UI origins (comma-separated). Required allowlist in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
