# Local Docker Compose Postgres is mapped to host port 5433
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/pulse_flag

# Protects /admin/* when set. Must match Next.js FEATURE_FLAGS_ADMIN_API_KEY.
FEATURE_FLAGS_API_KEY=dev-feature-flags-api-key

# Comma-separated exact origins (in addition to localhost/Vercel regex in code)
# Production example: https://your-admin.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
