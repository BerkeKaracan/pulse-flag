# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase Auth (safe to expose — anon key is public by design; protect with RLS in Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix these with NEXT_PUBLIC_
FEATURE_FLAGS_API_URL=http://127.0.0.1:8002
FEATURE_FLAGS_ADMIN_API_KEY=change-me-to-a-long-random-secret
