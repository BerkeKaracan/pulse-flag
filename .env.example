# Public app URL (used by server-side fetches to the BFF)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Auth.js (Google + GitHub only — no email/password)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated allowlist; OAuth accounts not listed are rejected
ADMIN_EMAILS=you@gmail.com

# Server-only: FastAPI base URL (do NOT use NEXT_PUBLIC_ for the admin key)
FEATURE_FLAGS_API_URL=http://127.0.0.1:8002
FEATURE_FLAGS_ADMIN_API_KEY=dev-feature-flags-api-key
